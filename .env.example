# Required
MONGO_URI=mongodb://127.0.0.1:27017/gatepass
JWT_SECRET=replace-with-a-long-random-string

# Optional: separate secret for signed QR tokens (defaults to JWT_SECRET)
# QR_SECRET=another-long-random-string

# Optional: lets CI/ops create staff accounts with the x-staff-key header.
# Leave unset to disable key-based staff provisioning.
# STAFF_SIGNUP_KEY=

# Optional: only allow mentor self-registration from this email domain,
# e.g. college.edu. Leave unset to accept any domain.
# MENTOR_EMAIL_DOMAIN=

PORT=5000
